# Nightly job: vulnerability scan, then email.
# When enabled in .env, the same run also checks for newer images and
# applies Watchtower. There is no second schedule.
# install.sh copies this file to /etc/cron.d/trivy-scan
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
0 3 * * * root /srv/stacks/trivy/scripts/scan.sh
