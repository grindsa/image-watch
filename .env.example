# Copy to /srv/stacks/trivy/.env and keep mode 600.
# Values are read literally. Wrap values that contain spaces in double quotes.
# Do not put newlines in a value. $ is not expanded.

# Stable name for this machine. Used in every JSON file and in the email subject.
# Leave empty to fall back to the hostname at scan time.
SERVER_ID=

# Optional label so a collector can tell inventory id and hostname apart.
# The scanner always records the live hostname as well.
TZ=UTC

TRIVY_STACK_DIR=/srv/stacks/trivy
TRIVY_DATA_DIR=/srv/data/trivy
TRIVY_CONTAINER=trivy

# MEDIUM is included so the email can list critical, high, and medium findings.
TRIVY_SEVERITY=CRITICAL,HIGH,MEDIUM
TRIVY_TIMEOUT=15m
TRIVY_SCANNERS=vuln

# Email is sent after every scan when this is true.
EMAIL_ENABLED=false
EMAIL_SUBJECT_PREFIX=[trivy]
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Comma-separated recipients.
SMTP_TO=
# starttls (port 587), ssl (port 465), or none (internal relay).
SMTP_TLS=starttls
SMTP_TLS_INSECURE=false
SMTP_CA_FILE=
SMTP_TIMEOUT=30
# 0 means no cap.
EMAIL_MAX_ROWS_PER_SEVERITY=0

# The nightly cron job runs a DIUN check before the vulnerability scan when
# this is true. DIUN has no schedule of its own. install.sh --with-diun sets it.
DIUN_ENABLED=false

# The same cron job runs Watchtower once, after the report, when this is true.
# Leave it false. MONITOR_ONLY=false allows recreates. LABEL_ENABLE=true still
# limits that to containers labeled com.centurylinklabs.watchtower.enable=true.
WATCHTOWER_ENABLED=false
WATCHTOWER_MONITOR_ONLY=true
WATCHTOWER_LABEL_ENABLE=true
WATCHTOWER_CLEANUP=false
WATCHTOWER_ROLLING_RESTART=true
