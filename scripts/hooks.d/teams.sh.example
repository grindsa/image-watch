#!/bin/sh
# Copy to teams.sh, chmod +x, and export TEAMS_WEBHOOK_URL for the scan service.
# Posts counts only.

set -eu

python3 - <<'PY'
import json
import os
import urllib.request

summary = json.load(open(os.environ["SUMMARY_PATH"], encoding="utf-8"))
text = (
    f"[{summary['server_id']}] trivy "
    f"{summary['critical']} critical, {summary['high']} high, {summary['medium']} medium"
)
payload = json.dumps({"text": text}).encode("utf-8")
request = urllib.request.Request(
    os.environ["TEAMS_WEBHOOK_URL"],
    data=payload,
    headers={"Content-Type": "application/json"},
)
urllib.request.urlopen(request, timeout=20).read()
PY
