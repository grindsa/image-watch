#!/bin/sh
# Copy to prometheus-textfile.sh and chmod +x.
# Set TEXTFILE_DIR to a directory scraped by node_exporter's textfile collector.

set -eu

python3 - <<'PY'
import json
import os
from pathlib import Path

summary = json.load(open(os.environ["SUMMARY_PATH"], encoding="utf-8"))
server = str(summary["server_id"]).replace("\\", "\\\\").replace('"', '\\"').replace("\n", " ")
lines = [
    "# HELP trivy_vulnerabilities Vulnerabilities on unique running images.",
    "# TYPE trivy_vulnerabilities gauge",
]
for severity in ("critical", "high", "medium"):
    lines.append(f'trivy_vulnerabilities{{server_id="{server}",severity="{severity}"}} {int(summary[severity])}')
updates = (summary.get("update_status") or {}).get("available")
if updates is not None:
    lines.append("# HELP trivy_update_notifications DIUN update events currently recorded.")
    lines.append("# TYPE trivy_update_notifications gauge")
    lines.append(f'trivy_update_notifications{{server_id="{server}"}} {int(updates)}')
destination = Path(os.environ["TEXTFILE_DIR"]) / "trivy.prom"
destination.write_text("\n".join(lines) + "\n", encoding="utf-8")
PY
