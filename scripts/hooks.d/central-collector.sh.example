#!/bin/sh
# Copy to central-collector.sh and chmod +x.
# Set COLLECTOR to a destination such as collector.example:/var/lib/image-watch
# The copy is grouped by server_id so several machines can land on one host.

set -eu

python3 - <<'PY'
import json
import os

summary = json.load(open(os.environ["SUMMARY_PATH"], encoding="utf-8"))
open(os.environ["REPORTS_DIR"] + "/.server_id", "w", encoding="utf-8").write(summary["server_id"] + "\n")
PY

server_id=$(cat "$REPORTS_DIR/.server_id")
rsync -a --delete "$REPORTS_DIR/" "$COLLECTOR/$server_id/"
